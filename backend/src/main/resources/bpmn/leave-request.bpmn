<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_LeaveRequest"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.30.0">
  <bpmn:process id="leave-request" name="Leave request" isExecutable="true">
    <bpmn:startEvent id="StartEvent_LeaveRequested" name="Leave requested">
      <bpmn:outgoing>Flow_StartToValidate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Activity_ValidateLeave" name="Validate leave request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-leave" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateToGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_RequestValid" name="Request valid?" default="Flow_InvalidDefault">
      <bpmn:incoming>Flow_ValidateToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_InvalidDefault</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Activity_ManagerApproval" name="Manager approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="leave-approval" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?" default="Flow_RejectedDefault">
      <bpmn:incoming>Flow_ApprovalToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_RejectedDefault</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Activity_FinalizeApproved" name="Finalize as approved">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finalize-leave" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;APPROVED&#34;" target="outcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLeaveApproved</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_LeaveApproved" name="Leave approved">
      <bpmn:incoming>Flow_ToLeaveApproved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_Merge" name="Merge">
      <bpmn:incoming>Flow_InvalidDefault</bpmn:incoming>
      <bpmn:incoming>Flow_RejectedDefault</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToFinalizeRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Activity_FinalizeRejected" name="Finalize as rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finalize-leave" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;REJECTED&#34;" target="outcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MergeToFinalizeRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLeaveRejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_LeaveRejected" name="Leave rejected">
      <bpmn:incoming>Flow_ToLeaveRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartToValidate" sourceRef="StartEvent_LeaveRequested" targetRef="Activity_ValidateLeave" />
    <bpmn:sequenceFlow id="Flow_ValidateToGateway" sourceRef="Activity_ValidateLeave" targetRef="Gateway_RequestValid" />
    <bpmn:sequenceFlow id="Flow_Valid" name="valid" sourceRef="Gateway_RequestValid" targetRef="Activity_ManagerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InvalidDefault" name="invalid" sourceRef="Gateway_RequestValid" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ApprovalToGateway" sourceRef="Activity_ManagerApproval" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_Approved" name="approved" sourceRef="Gateway_Approved" targetRef="Activity_FinalizeApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RejectedDefault" name="rejected" sourceRef="Gateway_Approved" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_MergeToFinalizeRejected" sourceRef="Gateway_Merge" targetRef="Activity_FinalizeRejected" />
    <bpmn:sequenceFlow id="Flow_ToLeaveApproved" sourceRef="Activity_FinalizeApproved" targetRef="EndEvent_LeaveApproved" />
    <bpmn:sequenceFlow id="Flow_ToLeaveRejected" sourceRef="Activity_FinalizeRejected" targetRef="EndEvent_LeaveRejected" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="leave-request">
      <bpmndi:BPMNShape id="StartEvent_LeaveRequested_di" bpmnElement="StartEvent_LeaveRequested">
        <dc:Bounds x="160" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="137" y="145" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_ValidateLeave_di" bpmnElement="Activity_ValidateLeave">
        <dc:Bounds x="250" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_RequestValid_di" bpmnElement="Gateway_RequestValid" isMarkerVisible="true">
        <dc:Bounds x="410" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="398" y="71" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_ManagerApproval_di" bpmnElement="Activity_ManagerApproval">
        <dc:Bounds x="530" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Approved_di" bpmnElement="Gateway_Approved" isMarkerVisible="true">
        <dc:Bounds x="690" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="689" y="71" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_FinalizeApproved_di" bpmnElement="Activity_FinalizeApproved">
        <dc:Bounds x="810" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_LeaveApproved_di" bpmnElement="EndEvent_LeaveApproved">
        <dc:Bounds x="972" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="952" y="145" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="690" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="700" y="332" width="31" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_FinalizeRejected_di" bpmnElement="Activity_FinalizeRejected">
        <dc:Bounds x="810" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_LeaveRejected_di" bpmnElement="EndEvent_LeaveRejected">
        <dc:Bounds x="972" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="954" y="325" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_StartToValidate_di" bpmnElement="Flow_StartToValidate">
        <di:waypoint x="196" y="120" />
        <di:waypoint x="250" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ValidateToGateway_di" bpmnElement="Flow_ValidateToGateway">
        <di:waypoint x="350" y="120" />
        <di:waypoint x="410" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Valid_di" bpmnElement="Flow_Valid">
        <di:waypoint x="460" y="120" />
        <di:waypoint x="530" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="484" y="102" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_InvalidDefault_di" bpmnElement="Flow_InvalidDefault">
        <di:waypoint x="435" y="145" />
        <di:waypoint x="435" y="300" />
        <di:waypoint x="690" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="444" y="218" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ApprovalToGateway_di" bpmnElement="Flow_ApprovalToGateway">
        <di:waypoint x="630" y="120" />
        <di:waypoint x="690" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="740" y="120" />
        <di:waypoint x="810" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="752" y="102" width="46" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_RejectedDefault_di" bpmnElement="Flow_RejectedDefault">
        <di:waypoint x="715" y="145" />
        <di:waypoint x="715" y="275" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="724" y="207" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MergeToFinalizeRejected_di" bpmnElement="Flow_MergeToFinalizeRejected">
        <di:waypoint x="740" y="300" />
        <di:waypoint x="810" y="300" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToLeaveApproved_di" bpmnElement="Flow_ToLeaveApproved">
        <di:waypoint x="910" y="120" />
        <di:waypoint x="972" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToLeaveRejected_di" bpmnElement="Flow_ToLeaveRejected">
        <di:waypoint x="910" y="300" />
        <di:waypoint x="972" y="300" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
