# Database Configuration (PostgreSQL in Docker)
DB_NAME=leavedb
DB_USER=leave_user
DB_PASSWORD=your_secure_password_here
DB_PORT=5432

# Camunda 8 Self-Managed Configuration
# When running Spring Boot inside Docker and Camunda on host / compose:
CAMUNDA_GRPC_ADDRESS=http://host.docker.internal:26500
CAMUNDA_REST_ADDRESS=http://host.docker.internal:8080

# Camunda Authentication (Optional for local C8 Run, required if Identity is enabled)
CAMUNDA_USERNAME=demo
CAMUNDA_PASSWORD=demo
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8081
